# Dependencies
node_modules/

# Build output
dist/

# IDE
.vscode/
.idea/

# Env files with secrets
.env.local
.env.*.local

# Wrangler's local secret store. `npx wrangler dev` reads the Unsplash key
# from .dev.vars, so an untracked-but-unignored one is a `git add -A` away
# from putting the key in this repo's history — the exact exposure #534
# exists to close, only permanent this time.
.dev.vars
.dev.vars.*
.wrangler/

# OS
.DS_Store

# PWA dev
dev-dist/
scripts/diag-output/

# Git worktrees
.worktrees/

# Debug artefacts
debug-*.png

# Visual brainstorming companion (local mockups)
.superpowers/

# Spike scratch. Spikes live on their own branches (e.g. `spike/tab-tracing`,
# which carries its own .gitignore for its outputs); on every other branch what
# is left in here is leftover generated output that nothing should track.
# Already-tracked files are unaffected — ignore rules never apply to them — so
# the spike branches keep their sources. Adding a *new* file on one of those
# branches needs `git add -f`.
spike/
